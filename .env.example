# `pnpm juno:setup` creates .env.local with paths for this machine.
# These values are examples only. Never commit .env.local.
AGENT_WORKBENCH_ROOT=C:\JunoWorkbench
JUNO_OVERSIGHT_ROOT=C:\path\to\Juno-Oversight

# Required for Live missions. Not required for `pnpm loop:smoke`.
CURSOR_API_KEY=

# Optional OpenAI-compatible provider.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Optional: require a fresh smoke-loop gate before scheduler execution.
# JUNO_REQUIRE_LOOP_GATE=1
