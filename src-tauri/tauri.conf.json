{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Juno Oversight",
  "version": "0.1.0",
  "identifier": "com.franklinnexus.junooversight",
  "build": {
    "frontendDist": "../out",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "corepack pnpm build:desktop"
  },
  "app": {
    "windows": [
      {
        "title": "Juno Oversight HUD",
        "width": 1440,
        "height": 900,
        "resizable": true,
        "fullscreen": false,
        "minWidth": 1024,
        "minHeight": 720
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "resources/juno-runtime/": "juno-runtime/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
